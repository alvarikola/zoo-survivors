---
import Sprite from '../../components/Sprite.astro';
import Base from '../../layouts/Base.astro';
import { animales } from '../../data/animales.js';
---
<Base title="Animales">
  <section class="wrap page">
    <h1>Animales</h1>
    <p class="lead">Los defensores del zoo. Cada uno juega distinto.</p>
    <div class="grid3">
      {animales.map((a) => (
        <a class="card animal" href={`/animales/${a.slug}/`}>
          <span class="em"><Sprite a={a} /></span><h3>{a.nombre}</h3><p>{a.resumen}</p><span class="tag">{a.bonus}</span>
        </a>
      ))}
      <div class="card animal ghost"><span class="em"><img class="px ph" src="/sprites/placeholder.svg" alt="" /></span><h3>Más animales</h3><p>Aún en desarrollo.</p><span class="tag">próximamente</span></div>
    </div>
  </section>
</Base>
